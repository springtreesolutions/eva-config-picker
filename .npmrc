# Quarantine: refuse to resolve a package version published less than seven
# days ago. Most malicious releases are caught and pulled within hours, so a
# short delay removes the window they depend on without holding back real work.
#
# Days here. Bun expresses the same rule in seconds in bunfig.toml, and the two
# must agree — a developer using one toolchain would otherwise get a different
# answer from the other.
#
# This file belongs beside every package.json in the repository, not only at the
# root: npm resolves project configuration from the nearest ancestor holding a
# package.json and stops there, so a root file is never read by an install run
# inside a package that carries its own manifest. The compliance workflow checks
# each location.
min-release-age=7

# No credentials in this file, ever. Tokens belong in the keychain, in 1Password
# or in a repository secret referenced as ${ENV}; a token committed here is a
# token published to everyone with read access. The compliance workflow refuses
# a literal credential and accepts an ${ENV} reference.
